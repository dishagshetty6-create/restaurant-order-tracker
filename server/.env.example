PORT=4000
NODE_ENV=development

# PostgreSQL — transactional core (orders, items, transitions, users)
DATABASE_URL=postgres://rot:rot_password@localhost:5432/rot
PG_POOL_MAX=10

# MongoDB — activity log / audit trail (write-heavy, schemaless)
MONGO_URL=mongodb://localhost:27017
MONGO_DB=rot_logs

# Redis — cache, distributed lock, rate limiting
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10

# Tuning
ORDER_LOCK_TTL_MS=3000
CACHE_TTL_SECONDS=30
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_WRITES=60
CORS_ORIGIN=http://localhost:5173
